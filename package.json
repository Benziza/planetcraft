    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@lucide/vue": "1.41.0",
    "reka-ui": "2.10.4",
    "three": "0.180.0",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/three": "0.180.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "jsdom": "26.1.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.0",
    "vue-tsc": "3.3.11"
